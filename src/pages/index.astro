---
import Layout from '../layouts/Layout.astro';
import { O_MNE, PILIRE } from '../data/site';
---

<Layout>
  {/* HERO SECTION - REDESIGNED */}
  <section style="background: #fff; padding: 4rem 0; overflow: hidden;">
    <div class="container" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 4rem; align-items: center;">
      <div style="text-align: left;">
        <h1 style="font-size: clamp(3rem, 8vw, 5rem); margin-bottom: 1.5rem; color: #000; line-height: 0.9;">
          TOMÁŠ<br /><span style="color: var(--secondary);">HÁJEK</span>
        </h1>
        <p style="font-size: 1.4rem; color: var(--text-muted); max-width: 600px; margin-bottom: 3rem; line-height: 1.4;">
          <strong>Multipotenciál</strong>, který propojuje svět technologií, vzdělávání a obrazu. Lektor LEGO Education, specialista na komunikaci a fotograf.
        </p>
        <div style="display: flex; gap: 1.5rem; justify-content: flex-start;">
          <a href="#pilire" class="btn btn-primary" style="background: #000; padding: 1rem 2rem;">Moje aktivity</a>
          <a href="/kontakt" class="btn" style="border: 2px solid #000; padding: 1rem 2rem;">Kontakt</a>
        </div>
      </div>
      <div style="position: relative;">
        <div style="width: 100%; aspect-ratio: 4/5; background: #f1f5f9; border-radius: 2rem; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; position: relative;">
          <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: var(--text-muted); text-align: center; width: 80%;">
            <p style="font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 1rem;">[Zde bude tvá velká fotka v klobouku]</p>
            <p style="font-size: 0.9rem;">Díky klobouku fotka krásně vyplní tento vertikální ořez.</p>
          </div>
          {/* Dekorativní prvek na pozadí */}
          <div style="position: absolute; bottom: -20px; right: -20px; width: 150px; height: 150px; background: var(--secondary); opacity: 0.2; border-radius: 50%; z-index: 0;"></div>
        </div>
      </div>
    </div>
  </section>

  {/* TRUST SIGNALS / STATS */}
  <section style="background: var(--primary); color: white; padding: 4rem 0;">
    <div class="container">
      <div class="grid grid-3" style="text-align: center;">
        {O_MNE.stats.map(stat => (
          <div>
            <div style="font-family: var(--font-display); font-size: 3rem; font-weight: 700; margin-bottom: 0.5rem;">
              {stat.cislo}
            </div>
            <div style="font-size: 1.1rem; opacity: 0.9;">
              {stat.popisek}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* PILIŘE ČINNOSTI */}
  <section id="pilire">
    <div class="container">
      <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 4rem;">Co dělám a co mě baví</h2>
      <div class="grid grid-2 lg-grid-3">
        {PILIRE.map(pilir => (
          <a href={pilir.odkaz} style="background: var(--bg-alt); padding: 2.5rem; border-radius: 1rem; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s;" class="pilir-card">
            <h3 style="color: var(--primary); font-size: 1.5rem; margin-bottom: 1rem;">{pilir.nazev}</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">{pilir.popis}</p>
            <span style="font-weight: 600; color: var(--secondary); text-transform: uppercase; font-size: 0.8rem;">Více informací →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .pilir-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border-color: var(--primary);
    }
  </style>
</Layout>
