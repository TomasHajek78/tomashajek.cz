---
import Layout from '../layouts/Layout.astro';
import { O_MNE, PILIRE } from '../data/site';
---

<Layout>
  {/* FULL-WIDTH BACKGROUND HERO */}
  <section class="hero">
    <div class="hero-bg">
      <img src="/Tomas-hajek2.jpg" alt="" />
      <div class="hero-overlay"></div>
    </div>
    
    <div class="container hero-container">
      <div class="hero-content">
        <p class="hero-text">
          <strong>Multipotenciál</strong>, který propojuje svět technologií, vzdělávání a obrazu. Lektor LEGO Education, specialista na komunikaci a fotograf.
        </p>
        <div class="hero-btns">
          <a href="#pilire" class="btn btn-primary" style="background: #000; padding: 1rem 2rem;">Moje aktivity</a>
          <a href="/kontakt" class="btn" style="border: 2px solid #000; padding: 1rem 2rem;">Kontakt</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      position: relative;
      min-height: 70vh;
      display: flex;
      align-items: center;
      background: #fff;
      overflow: hidden;
      padding: 4rem 0;
    }
    .hero-bg {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center right; /* Aby byl obličej vpravo vidět */
    }
    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      /* Gradient: zprava (transparentní) doleva (bílá) a dolů (bílá) */
      background: linear-gradient(to right, #fff 20%, rgba(255,255,255,0.4) 50%, transparent 100%),
                  linear-gradient(to bottom, transparent 60%, #fff 100%);
    }
    .hero-container {
      position: relative;
      z-index: 10;
    }
    .hero-content {
      max-width: 550px;
    }
    .hero-text {
      font-size: 1.5rem;
      color: #000;
      line-height: 1.4;
      margin-bottom: 2.5rem;
      text-shadow: 0 0 20px rgba(255,255,255,0.8); /* Pro jistotu čitelnosti */
    }
    .hero-btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    @media (max-width: 768px) {
      .hero {
        min-height: auto;
        padding: 2rem 0 4rem;
      }
      .hero-bg {
        position: relative;
        height: 400px;
        margin-bottom: 2rem;
      }
      .hero-overlay {
        background: linear-gradient(to bottom, transparent 60%, #fff 100%);
      }
      .hero-text {
        font-size: 1.2rem;
      }
    }
  </style>

  {/* TRUST SIGNALS / STATS */}
  <section style="background: var(--accent); color: white; padding: 4rem 0;">
    <div class="container">
      <div class="grid grid-3" style="text-align: center;">
        {O_MNE.stats.map(stat => (
          <div>
            <div style="font-family: var(--font-display); font-size: 3rem; font-weight: 700; margin-bottom: 0.5rem;">
              {stat.cislo}
            </div>
            <div style="font-size: 1.1rem; opacity: 0.9;">
              {stat.popisek}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* PILIŘE ČINNOSTI */}
  <section id="pilire">
    <div class="container">
      <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 4rem;">Co dělám a co mě baví</h2>
      <div class="grid grid-2 lg-grid-3">
        {PILIRE.map(pilir => (
          <a href={pilir.odkaz} style="background: var(--bg-alt); padding: 2.5rem; border-radius: 1rem; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s;" class="pilir-card">
            <h3 style="color: var(--primary); font-size: 1.5rem; margin-bottom: 1rem;">{pilir.nazev}</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">{pilir.popis}</p>
            <span style="font-weight: 600; color: var(--secondary); text-transform: uppercase; font-size: 0.8rem;">Více informací →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .pilir-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border-color: var(--primary);
    }
  </style>
</Layout>
